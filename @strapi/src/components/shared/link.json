{
  "collectionName": "components_shared_links",
  "info": {
    "displayName": "Link"
  },
  "options": {},
  "attributes": {
    "text": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true,
      "regex": "^(https?:\\/\\/([\\w-]+\\.)+[\\w-]{2,}(\\/[\\w\\-._~:/?#[\\]@!$&'()*+,;=]*)?|[\\w.%+-]+@[\\w.-]+\\.[a-zA-Z]{2,})$"
    },
    "target_blank": {
      "type": "boolean",
      "default": true
    }
  },
  "config": {}
}
