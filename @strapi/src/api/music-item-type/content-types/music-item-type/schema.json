{
  "kind": "collectionType",
  "collectionName": "music_item_types",
  "info": {
    "singularName": "music-item-type",
    "pluralName": "music-item-types",
    "displayName": "Music Item Type"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "musicItems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::music-item.music-item",
      "mappedBy": "itemType"
    }
  }
}
